# Version Control
.git/
.gitignore
.gitattributes
.github/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
venv/
.venv/
ENV/

# Secrets, Environment Files & Keys (NEVER BAKE INTO IMAGE)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Local Databases, Uploads & Storage (Mount via Volumes at runtime)
*.db
!test.db
cases.db
feedback.db
users.db
cases_storage/
judgments/
index_store_backup_*/

# Testing & Logs
.pytest_cache/
.coverage
htmlcov/
*.log

# Frontend (Deployed via Vercel - exclude from backend Docker build context)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Operating System Temporary Files
.DS_Store
Thumbs.db
desktop.ini
